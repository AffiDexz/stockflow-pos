// StockFlow POS - Prisma schema
// Database: MySQL 8+ (InnoDB engine required for row-level locking / SELECT ... FOR UPDATE)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Product & Inventory
// ---------------------------------------------------------------------------
model Product {
  id             Int      @id @default(autoincrement())
  name           String
  price          Decimal  @db.Decimal(10, 2)
  availableStock Int      @default(0) // free-to-sell stock
  reservedStock  Int      @default(0) // currently held by active reservations
  imageUrl       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  cartItems    CartItem[]
  orderItems   OrderItem[]
  reservations Reservation[]

  @@map("products")
}

// ---------------------------------------------------------------------------
// Cart
// ---------------------------------------------------------------------------
model Cart {
  id        String     @id @default(uuid())
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     CartItem[]

  @@map("carts")
}

model CartItem {
  id        Int      @id @default(autoincrement())
  cartId    String
  productId Int
  quantity  Int
  createdAt DateTime @default(now())

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([cartId, productId]) // one row per product per cart
  @@map("cart_items")
}

// ---------------------------------------------------------------------------
// Order lifecycle
// ---------------------------------------------------------------------------
enum OrderStatus {
  PENDING
  RESERVED
  PAID
  FAILED
  CANCELLED
  EXPIRED
}

model Order {
  id         Int         @id @default(autoincrement())
  reference  String      @unique // human-friendly ref e.g. ORD-1008
  customer   String      @default("Guest")
  status     OrderStatus @default(RESERVED)
  totalAmount Decimal    @db.Decimal(10, 2)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  items        OrderItem[]
  reservations Reservation[]
  payments     Payment[]

  @@map("orders")
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  productId Int
  name      String  // snapshot of product name at purchase time
  unitPrice Decimal @db.Decimal(10, 2) // snapshot of price at purchase time
  quantity  Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

// ---------------------------------------------------------------------------
// Stock reservation
// ---------------------------------------------------------------------------
enum ReservationStatus {
  ACTIVE
  CONFIRMED
  RELEASED
  EXPIRED
}

model Reservation {
  id        Int               @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int
  status    ReservationStatus @default(ACTIVE)
  expiresAt DateTime
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([status, expiresAt])
  @@map("reservations")
}

// ---------------------------------------------------------------------------
// Mock payment
// ---------------------------------------------------------------------------
enum PaymentStatus {
  SUCCESS
  FAILED
  TIMEOUT
}

model Payment {
  id             Int           @id @default(autoincrement())
  orderId        Int
  idempotencyKey String        @unique // guarantees one payment record per key
  amount         Decimal       @db.Decimal(10, 2)
  status         PaymentStatus
  createdAt      DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}
